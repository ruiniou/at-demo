{
  "$metadata": {
    "designSystem": "AZ Design System",
    "category": "typography",
    "strategy": "semantic typography tokens"
  },

  "fontFamily": {
    "sans": {
      "$value": "PingFang SC"
    },

    "mono": {
      "$value": "Menlo"
    }
  },

  "fontWeight": {
    "regular": {
      "$value": 400
    },

    "medium": {
      "$value": 500
    },

    "semibold": {
      "$value": 600
    }
  },

  "fontSize": {
    "xs": {
      "$value": "12px"
    },

    "sm": {
      "$value": "13px"
    },

    "md": {
      "$value": "14px"
    },

    "lg": {
      "$value": "16px"
    }
  },

  "lineHeight": {
    "tight": {
      "$value": "16px"
    },

    "compact": {
      "$value": "18px"
    },

    "normal": {
      "$value": "20px"
    },

    "relaxed": {
      "$value": "24px"
    },

    "heading": {
      "$value": "22px"
    }
  },

  "semantic": {
    "heading": {
      "fontFamily": "{fontFamily.sans}",
      "fontSize": "{fontSize.lg}",
      "fontWeight": "{fontWeight.semibold}",
      "lineHeight": "{lineHeight.heading}",
      "$description": "Section titles, H1-H4, Ask User Question title"
    },

    "body": {
      "fontFamily": "{fontFamily.sans}",
      "fontSize": "{fontSize.md}",
      "fontWeight": "{fontWeight.regular}",
      "lineHeight": "{lineHeight.relaxed}",
      "$description": "AI paragraph, User prompt bubble"
    },

    "body-compact": {
      "fontFamily": "{fontFamily.sans}",
      "fontSize": "{fontSize.md}",
      "fontWeight": "{fontWeight.regular}",
      "lineHeight": "{lineHeight.compact}",
      "$description": "Tool name, diff metadata"
    },

    "caption": {
      "fontFamily": "{fontFamily.sans}",
      "fontSize": "{fontSize.sm}",
      "fontWeight": "{fontWeight.regular}",
      "lineHeight": "{lineHeight.normal}",
      "$description": "Inline tags, status details"
    },

    "small": {
      "fontFamily": "{fontFamily.sans}",
      "fontSize": "{fontSize.xs}",
      "fontWeight": "{fontWeight.regular}",
      "lineHeight": "{lineHeight.tight}",
      "$description": "CTA Button text, Tag/Chip"
    },

    "code": {
      "fontFamily": "{fontFamily.mono}",
      "fontSize": "{fontSize.sm}",
      "fontWeight": "{fontWeight.regular}",
      "lineHeight": "1.25",
      "$description": "Code block lines, diff lines"
    }
  }
}